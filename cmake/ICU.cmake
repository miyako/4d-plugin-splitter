string(JSON icu_url GET "${dependency_lock}" icu url)
string(JSON icu_sha256 GET "${dependency_lock}" icu sha256)
FetchContent_Declare(splitter_icu URL "${icu_url}" URL_HASH "SHA256=${icu_sha256}")
FetchContent_MakeAvailable(splitter_icu)
set(icu_source "${splitter_icu_SOURCE_DIR}/source")
set(SPLITTER_ICU_DATA "${icu_source}/data/in/icudt79l.dat")

# Build the pinned ICU libraries privately, not the host/OS ICU or ICU tools.
file(GLOB icu_common CONFIGURE_DEPENDS "${icu_source}/common/*.cpp")
file(GLOB icu_i18n CONFIGURE_DEPENDS "${icu_source}/i18n/*.cpp")
add_library(splitter_icu_stub STATIC "${icu_source}/stubdata/stubdata.cpp")
add_library(splitter_icu_common STATIC ${icu_common})
add_library(splitter_icu_i18n STATIC ${icu_i18n})
foreach(target splitter_icu_stub splitter_icu_common splitter_icu_i18n)
    target_compile_features(${target} PUBLIC cxx_std_17)
    target_include_directories(${target} SYSTEM PUBLIC "${icu_source}/common")
    target_compile_definitions(${target} PUBLIC U_STATIC_IMPLEMENTATION
        UCONFIG_NO_FILE_IO=1 U_ENABLE_DYLOAD=0 NOMINMAX)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE TRUE
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN TRUE)
endforeach()
target_include_directories(splitter_icu_i18n PRIVATE "${icu_source}/i18n")
target_compile_definitions(splitter_icu_common PRIVATE U_COMMON_IMPLEMENTATION)
target_compile_definitions(splitter_icu_i18n PRIVATE U_I18N_IMPLEMENTATION)
target_compile_definitions(splitter_icu_stub PRIVATE U_DATA_IMPLEMENTATION)
target_link_libraries(splitter_icu_common PUBLIC splitter_icu_stub ${CMAKE_DL_LIBS})
target_link_libraries(splitter_icu_i18n PUBLIC splitter_icu_common)
if(WIN32)
    target_link_libraries(splitter_icu_common PRIVATE advapi32)
endif()
